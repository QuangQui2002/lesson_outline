{
  "manifest_version": 3,
  "name": "LMS TVU Question Helper",
  "version": "1.0.12",
  "description": "Tự động lưu câu hỏi review LMS TVU và hỗ trợ AI đáp án.",
  "permissions": [
    "storage",
    "tabs"
  ],
  "host_permissions": [
    "https://lms-tvu.onschool.edu.vn/*",
    "https://lesson-outline-h788.onrender.com/*",
    "https://*.cmctelecom.vn/*",
    "https://s3.cloud.cmctelecom.vn/*"
  ],
  "background": {
    "service_worker": "background.js"
  },
  "content_scripts": [
    {
      "matches": [
        "https://lms-tvu.onschool.edu.vn/*"
      ],
      "js": [
        "vendor/katex/katex.min.js",
        "content.js"
      ],
      "css": [
        "vendor/katex/katex.min.css",
        "styles.css"
      ],
      "run_at": "document_idle",
      "all_frames": true
    }
  ],
  "web_accessible_resources": [
    {
      "resources": [
        "vendor/katex/fonts/*"
      ],
      "matches": [
        "https://lms-tvu.onschool.edu.vn/*"
      ]
    }
  ],
  "action": {
    "default_title": "LMS TVU Helper",
    "default_popup": "popup.html"
  }
}
