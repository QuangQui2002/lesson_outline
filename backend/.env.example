SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=
SUPABASE_IMAGE_BUCKET=question-images
QUESTION_IMAGE_MAX_BYTES=8388608
QUESTION_IMAGE_FETCH_TIMEOUT_MS=15000
QUESTION_IMAGE_STRICT=false
# Optional comma-separated domains. Empty allows any public HTTPS host.
QUESTION_IMAGE_ALLOWED_HOSTS=
SUPABASE_AUDIO_BUCKET=question-audio
QUESTION_AUDIO_MAX_BYTES=33554432
QUESTION_AUDIO_FETCH_TIMEOUT_MS=30000
QUESTION_AUDIO_STRICT=false
# Optional comma-separated domains. Empty allows any public HTTPS host.
QUESTION_AUDIO_ALLOWED_HOSTS=
JSON_BODY_LIMIT=10mb
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
# Optional comma-separated API paths to skip notifications.
TELEGRAM_NOTIFY_IGNORE_PATHS=/api/ping,/api/health/db

# Gemini config for attempt answers
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.0-flash

