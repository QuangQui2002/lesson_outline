SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=
SUPABASE_IMAGE_BUCKET=question-images
QUESTION_IMAGE_MAX_BYTES=8388608
QUESTION_IMAGE_FETCH_TIMEOUT_MS=15000
QUESTION_IMAGE_STRICT=false
# Optional comma-separated domains. Empty allows any public HTTPS host.
QUESTION_IMAGE_ALLOWED_HOSTS=
SUPABASE_AUDIO_BUCKET=question-audio
QUESTION_AUDIO_MAX_BYTES=33554432
QUESTION_AUDIO_FETCH_TIMEOUT_MS=30000
QUESTION_AUDIO_STRICT=false
# Optional comma-separated domains. Empty allows any public HTTPS host.
QUESTION_AUDIO_ALLOWED_HOSTS=
JSON_BODY_LIMIT=10mb
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
# Optional comma-separated API paths to skip notifications.
TELEGRAM_NOTIFY_IGNORE_PATHS=/api/ping,/api/health/db

# Gemini config for attempt answers (comma-separated models are tried in order)
GEMINI_API_KEY=
GEMINI_MODELS=gemini-flash-latest

# Security
# Required in production: protects create/update/delete question and delete subject (header X-Admin-Key).
# Empty in local dev = those routes stay open.
ADMIN_API_KEY=
# Comma-separated allowed origins. Empty allows any origin.
CORS_ORIGINS=
# Number of proxies in front of the app (Render = 1). Used to read the real client IP.
TRUST_PROXY=1
# Set true to turn off rate limiting, or scale all limits (e.g. 2 = double).
RATE_LIMIT_DISABLED=false
RATE_LIMIT_MULTIPLIER=1
# Max characters of question/answer HTML, not counting base64 images.
MAX_QUESTION_TEXT_CHARS=50000
MAX_SOLVE_QUESTIONS=300

# Performance
# How often API stats are written to Supabase.
API_STATS_FLUSH_MS=60000
# Release the OCR worker after this idle time.
OCR_IDLE_TIMEOUT_MS=300000
# Empty = use RENDER_EXTERNAL_URL/api/ping on Render, no ping when running locally.
KEEP_ALIVE_URL=
